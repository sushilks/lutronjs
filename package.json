{
  "name": "lutronjs",
  "version": "1.0.0",
  "author": "Sushil Singh",
  "description": "API gateway for Lutron (RA2 Select / Caseta Pro) with bidirectional Loxone state sync",
  "license": "Apache-2.0",
  "main": "build/lutronServer.js",
  "engines": {
    "node": ">=22.4"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test build/test/*.test.js",
    "server": "node --env-file-if-exists=cfg/loxone.env --env-file-if-exists=cfg/${HUB:-none}.env --enable-source-maps ./build/lutronServer.js",
    "watch": "node --env-file-if-exists=cfg/loxone.env --env-file-if-exists=cfg/${HUB:-none}.env --enable-source-maps ./build/loxone_events.js",
    "discover": "node --env-file-if-exists=cfg/loxone.env --env-file-if-exists=cfg/${HUB:-none}.env ./build/discover_cli.js"
  }
}
