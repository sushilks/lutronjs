{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    // No "type": "module" in package.json, so this emits CommonJS. Legacy JS
    // configs require('/root/lutronjs/build/loxoneWSUtil'), keep it that way.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "rootDir": "./src",
    "outDir": "./build",
    "sourceMap": true,
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
